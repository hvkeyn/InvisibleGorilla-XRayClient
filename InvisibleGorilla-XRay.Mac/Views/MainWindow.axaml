<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InvisibleGorillaXRay.Mac.Views.MainWindow"
        Title="Invisible Gorilla XRay"
        Height="650" MinHeight="620"
        Width="400"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Color.DarkGray}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Color.LightGray}"
                BoxShadow="0 2 4 0 #66000000">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Rectangle Fill="{StaticResource Icon.InvisibleGorilla}" Grid.Column="0" 
                    Width="60" Height="60" Margin="0" 
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    
                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Margin="15,7,0,0" VerticalAlignment="Bottom" 
                        Text="INVISIBLE GORILLA"
                        FontWeight="Light" FontSize="14" Foreground="White"/>
                    <TextBlock Margin="15,-4,0,0" VerticalAlignment="Top" 
                        Text="XRAY"
                        FontWeight="Light" FontSize="42" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Stop status -->
            <StackPanel Grid.Row="0" Orientation="Vertical"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                IsVisible="True" x:Name="statusStop">
                
                <Grid Width="120" Height="120" Margin="0">
                    <Rectangle Fill="{StaticResource Icon.Stop}"/>
                </Grid>
                
                <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Ellipse
                        Width="12" Height="12" Margin="0,0,2,0"
                        VerticalAlignment="Center"
                        Fill="{StaticResource Color.Red}"/>
                    <TextBlock Text="{DynamicResource Lang.Status.Stopped}"
                        Margin="0" Foreground="White" FontWeight="Light" FontSize="16"
                        VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Wait for run status -->
            <StackPanel Grid.Row="0" Orientation="Vertical"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                IsVisible="False" x:Name="statusWaitForRun">
                
                <Grid Width="120" Height="120" Margin="0">
                    <Rectangle Fill="{StaticResource Icon.Stop}"/>
                    <ProgressBar IsIndeterminate="True" Width="80" Height="80"
                        Foreground="{StaticResource Color.Red}"
                        Background="Transparent"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                
                <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Ellipse
                        Width="12" Height="12" Margin="0,0,2,0"
                        VerticalAlignment="Center"
                        Fill="Gray"/>
                    <TextBlock Text="{DynamicResource Lang.Status.WaitForRun}"
                        Margin="0" Foreground="White" FontWeight="Light" FontSize="16"
                        VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Run status -->
            <StackPanel Grid.Row="0" Orientation="Vertical"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                IsVisible="False" x:Name="statusRun">

                <Grid Width="120" Height="120" Margin="0">
                    <!-- Glow effect -->
                    <Ellipse x:Name="effectGlow" Width="120" Height="120"
                        Fill="{StaticResource Color.Green}" Opacity="0.3"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Rectangle Fill="{StaticResource Icon.Run}"/>
                </Grid>
                
                <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Ellipse
                        Width="12" Height="12" Margin="0,0,2,0"
                        VerticalAlignment="Center"
                        Fill="{StaticResource Color.Green}"/>
                    <TextBlock Text="{DynamicResource Lang.Status.Running}"
                        Margin="0" Foreground="White" FontWeight="Light" FontSize="16"
                        VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Config name -->
            <TextBlock Grid.Row="2" Width="300"
                HorizontalAlignment="Center"
                TextAlignment="Center" TextTrimming="CharacterEllipsis"
                Margin="0" Foreground="White" FontWeight="Light" FontSize="18"
                x:Name="textServerConfig"
                Text="{DynamicResource Lang.Message.NoServerConfiguration}"/>

            <!-- Manage server configuration link -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Rectangle Fill="{StaticResource Icon.Server}"
                    Width="15" Height="15" Margin="0,0,7,0" 
                    HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <TextBlock Text="{DynamicResource Lang.Window.Main.ManageServerConfiguration}" 
                    TextDecorations="Underline"
                    HorizontalAlignment="Center" VerticalAlignment="Top" 
                    Margin="0" Foreground="{StaticResource Color.Blue}" 
                    FontWeight="Normal" FontSize="14" Cursor="Hand"
                    Tapped="OnManageServersClick"/>
            </StackPanel>

            <!-- Run button -->
            <Button Grid.Row="4" Width="200" Height="40" 
                Content="{DynamicResource Lang.Run}" Theme="{StaticResource Button.Rectangle.Green}" 
                FontWeight="Bold" FontSize="15" 
                Foreground="{StaticResource Color.Gray}" IsVisible="True"
                Click="OnRunButtonClick" x:Name="buttonRun"/>

            <!-- Cancel button -->
            <Button Grid.Row="4" Width="200" Height="40" 
                Content="{DynamicResource Lang.Cancel}" Theme="{StaticResource Button.Rectangle.Red}" 
                FontWeight="Bold" FontSize="15" 
                Foreground="{StaticResource Color.Gray}" IsVisible="False"
                Click="OnCancelButtonClick" x:Name="buttonCancel"/>

            <!-- Stop button -->
            <Button Grid.Row="4" Width="200" Height="40" 
                Content="{DynamicResource Lang.Stop}" Theme="{StaticResource Button.Rectangle.Red}" 
                FontWeight="Bold" FontSize="15" 
                Foreground="{StaticResource Color.Gray}" IsVisible="False"
                Click="OnStopButtonClick" x:Name="buttonStop"/>

            <Border Grid.Row="5"
                    Margin="15,4,15,6"
                    Padding="10,7"
                    VerticalAlignment="Top"
                    CornerRadius="8"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    Background="{StaticResource Color.LightGray}">
                <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse x:Name="infoStatusDot"
                                     Width="9"
                                     Height="9"
                                     Fill="Gray"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Lang.ConnectionInfo.Title}"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="12"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Padding="2,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnRefreshInfoButtonClick">
                            <TextBlock Text="↻"
                                       Foreground="{StaticResource Color.Blue}"
                                       FontSize="14"
                                       FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <Border Padding="7,6"
                            CornerRadius="5"
                            BorderBrush="#404040"
                            BorderThickness="1"
                            Background="#252525">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="78,*">
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource Lang.ConnectionInfo.IpLabel}"
                                           Foreground="#8A8A8A"
                                           FontSize="9"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="textInfoIp"
                                           Grid.Column="1"
                                           Text="—"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Grid ColumnDefinitions="78,Auto,*">
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource Lang.ConnectionInfo.LocationLabel}"
                                           Foreground="#8A8A8A"
                                           FontSize="9"
                                           Margin="0,1,0,0"
                                           VerticalAlignment="Top"/>
                                <TextBlock x:Name="textInfoFlag"
                                           Grid.Column="1"
                                           Text="🌐"
                                           FontSize="12"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="2" Spacing="1">
                                    <TextBlock x:Name="textInfoLocation"
                                               Foreground="#E8E8E8"
                                               FontSize="11"
                                               Text="—"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="textInfoCountry"
                                               Foreground="#B0B0B0"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="78,*">
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource Lang.ConnectionInfo.ProviderLabel}"
                                           Foreground="#8A8A8A"
                                           FontSize="9"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="textInfoOrg"
                                           Grid.Column="1"
                                           Foreground="#CFCFCF"
                                           FontSize="11"
                                           Text="—"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*">
                                <Border x:Name="borderInfoMode"
                                        IsVisible="False"
                                        Margin="0,0,8,0"
                                        Padding="5,2"
                                        CornerRadius="4"
                                        Background="#1E3A5F"
                                        BorderBrush="#2F5F9A"
                                        BorderThickness="1">
                                    <TextBlock x:Name="textInfoMode"
                                               Foreground="#7FB2FF"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock x:Name="textInfoVerdict"
                                           Grid.Column="1"
                                           Text="{DynamicResource Lang.ConnectionInfo.Idle}"
                                           Foreground="Gray"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2">
            <Grid Height="45" VerticalAlignment="Bottom" 
                Background="{StaticResource Color.LightGray}">

                <StackPanel Orientation="Horizontal" Margin="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center">

                    <Button Width="30" Height="30" Margin="0" 
                        Theme="{StaticResource Button.Circle}"
                        ToolTip.Tip="{DynamicResource Lang.ToolTip.About}"
                        Click="OnAboutButtonClick">
                        <Rectangle Fill="{StaticResource Icon.About}"
                            Width="6" Height="14" Margin="0" 
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Grid Width="30" Height="30" Margin="10,0,0,0">
                        <Button Theme="{StaticResource Button.Circle}" 
                            ToolTip.Tip="{DynamicResource Lang.ToolTip.CheckForUpdates}"
                            Click="OnUpdateButtonClick">
                            <Rectangle Fill="{StaticResource Icon.Update}"
                                Width="15" Height="15" Margin="0" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Ellipse Width="12" Height="12" Margin="-2" IsVisible="False"
                            Fill="{StaticResource Color.Orange}" 
                            Stroke="{StaticResource Color.LightGray}" StrokeThickness="2"
                            VerticalAlignment="Top" HorizontalAlignment="Right"
                            x:Name="notificationUpdate"/>
                    </Grid>

                    <Button Width="30" Height="30" Margin="10,0,0,0" 
                        Theme="{StaticResource Button.Circle}"
                        ToolTip.Tip="{DynamicResource Lang.ToolTip.Settings}"
                        Click="OnSettingsButtonClick">
                        <Rectangle Fill="{StaticResource Icon.Settings}"
                            Width="15" Height="15" Margin="0" 
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button Width="30" Height="30" Margin="10,0,0,0" 
                        Theme="{StaticResource Button.Circle}"
                        ToolTip.Tip="{DynamicResource Lang.ToolTip.BugReporting}"
                        Click="OnBugReportingButtonClick">
                        <Rectangle Fill="{StaticResource Icon.Bug}"
                            Width="12" Height="16" Margin="0" 
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button Width="30" Height="30" Margin="10,0,0,0"
                        Theme="{StaticResource Button.Circle}"
                        ToolTip.Tip="{DynamicResource Lang.ToolTip.SourceCodeOnGitHub}"
                        Click="OnGitHubButtonClick">
                        <Rectangle Fill="{StaticResource Icon.Github}"
                            Width="18" Height="16" Margin="0" 
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
