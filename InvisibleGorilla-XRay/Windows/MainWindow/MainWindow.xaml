<Window x:Class="InvisibleGorillaXRay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvisibleGorillaXRay"
        xmlns:Controls="clr-namespace:InvisibleGorillaXRay.Components"
        mc:Ignorable="d"
        Title="Invisible Gorilla XRay"
        Height="656" MinHeight="640"
        Width="400" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanMinimize">

    <Window.Background>
        <StaticResource ResourceKey="Color.DarkGray"/>
    </Window.Background>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Vertical"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                    Visibility="Visible" x:Name="statusStop">
                    
                    <Grid Width="72" Height="72" Margin="0">
                        <Rectangle Fill="{StaticResource Icon.Stop}"/>
                    </Grid>
                    
                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0 8 0 0">

                        <Ellipse
                            Width="12" Height="12" Margin="0 0 2 0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource Color.Red}"/>
                        <Label Content="{DynamicResource Lang.Status.Stopped}" FontFamily="{StaticResource SegoeUI}" 
                            Margin="0" Foreground="White" FontWeight="Light" FontSize="16"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0" Orientation="Vertical"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                    Visibility="Hidden" x:Name="statusWaitForRun">
                    
                    <Grid Width="120" Height="120" Margin="0">
                        <Rectangle Fill="{StaticResource Icon.Stop}"/>
                        <Controls:Loading Foreground="{StaticResource Color.Red}"/>
                    </Grid>
                    
                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0 10 0 0">

                        <Ellipse
                            Width="12" Height="12" Margin="0 0 2 0"
                            VerticalAlignment="Center"
                            Fill="Gray"/>
                        <Label Content="{DynamicResource Lang.Status.WaitForRun}" FontFamily="{StaticResource SegoeUI}" 
                            Margin="0" Foreground="White" FontWeight="Light" FontSize="16"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0" Orientation="Vertical"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                    Visibility="Hidden" x:Name="statusRun">

                    <Grid Width="72" Height="72" Margin="0">
                        <Controls:Glow x:Name="effectGlow"/>
                        <Rectangle Fill="{StaticResource Icon.Run}"/>
                    </Grid>
                    
                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0 8 0 0">

                        <Ellipse
                            Width="12" Height="12" Margin="0 0 2 0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource Color.Green}"/>
                        <Label Content="{DynamicResource Lang.Status.Running}" FontFamily="{StaticResource SegoeUI}" 
                            Margin="0" Foreground="White" FontWeight="Light" FontSize="16"/>
                    </StackPanel>
                </StackPanel>

                <Controls:Broadcast Grid.Row="0" VerticalAlignment="Top" 
                    Visibility="Hidden" x:Name="barBroadcast"/>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0 2 0 0">
                    <TextBlock Width="360"
                        HorizontalAlignment="Center" FontFamily="{StaticResource SegoeUI}"
                        TextAlignment="Center" TextTrimming="CharacterEllipsis"
                        Foreground="White" FontWeight="Light" FontSize="17"
                        x:Name="textServerConfig">
                        <Run Text="{DynamicResource Lang.Message.NoServerConfiguration}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Row="3"
                            x:Name="panelGoidaDetails"
                            HorizontalAlignment="Center"
                            Margin="8 4 8 0"
                            Visibility="Collapsed">
                    <Border Padding="14 8" CornerRadius="8"
                            BorderBrush="#3A3A3A" BorderThickness="1" Background="#232323">
                        <Border.Effect>
                            <DropShadowEffect Direction="270" Opacity="0.25" ShadowDepth="1" BlurRadius="4"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Controls:WifiSignal Grid.Column="0"
                                                 x:Name="wifiGoidaSignal"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 12 0"/>

                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="textGoidaSignalLabel"
                                               FontFamily="{StaticResource SegoeUI}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="textGoidaLatency"
                                               Margin="8 0 0 0"
                                               FontFamily="{StaticResource SegoeUI}"
                                               FontSize="12"
                                               FontWeight="Light"
                                               Foreground="#9A9A9A"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="textGoidaSummary"
                                           MaxWidth="270"
                                           Margin="0 2 0 0"
                                           FontFamily="{StaticResource SegoeUI}"
                                           TextWrapping="Wrap"
                                           FontWeight="Light"
                                           FontSize="11"
                                           LineHeight="14"
                                           Foreground="#BDBDBD"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 6 0 0">
                    <Rectangle Fill="{StaticResource Icon.Server}" Grid.Column="0" 
                        Width="15" Height="15" Margin="0 0 7 0" 
                        HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="2" Text="{DynamicResource Lang.Window.Main.ManageServerConfiguration}" 
                        FontFamily="{StaticResource SegoeUI}" TextDecorations="Underline"
                        HorizontalAlignment="Center" VerticalAlignment="Top" 
                        Margin="0" Foreground="{StaticResource Color.Blue}" 
                        FontWeight="Normal" FontSize="14" Cursor="Hand"
                        PreviewMouseDown="OnManageServersClick"/>
                </StackPanel>

                <Button Grid.Row="5" Width="200" Height="40" 
                    Content="{DynamicResource Lang.Run}" Style="{StaticResource Button.Rectangle.Green}" 
                    FontFamily="{StaticResource SegoeUI}" FontWeight="Bold" FontSize="15" 
                    Foreground="{StaticResource Color.Gray}" Visibility="Visible"
                    Click="OnRunButtonClick" x:Name="buttonRun">

                </Button>

                <Button Grid.Row="5" Width="200" Height="40" 
                    Content="{DynamicResource Lang.Cancel}" Style="{StaticResource Button.Rectangle.Red}" 
                    FontFamily="{StaticResource SegoeUI}" FontWeight="Bold" FontSize="15" 
                    Foreground="{StaticResource Color.Gray}" Visibility="Hidden"
                    Click="OnCancelButtonClick" x:Name="buttonCancel">

                </Button>

                <Button Grid.Row="5" Width="200" Height="40" 
                    Content="{DynamicResource Lang.Stop}" Style="{StaticResource Button.Rectangle.Red}" 
                    FontFamily="{StaticResource SegoeUI}" FontWeight="Bold" FontSize="15" 
                    Foreground="{StaticResource Color.Gray}" Visibility="Hidden"
                    Click="OnStopButtonClick" x:Name="buttonStop">

                </Button>

                <Border Grid.Row="7" VerticalAlignment="Bottom" Margin="15 6 15 4"
                    CornerRadius="8" BorderBrush="#3A3A3A" BorderThickness="1"
                    Background="{StaticResource Color.LightGray}">
                    <Border.Effect>
                        <DropShadowEffect Direction="270" Opacity="0.3" ShadowDepth="1" BlurRadius="4"/>
                    </Border.Effect>

                    <StackPanel Orientation="Vertical" Margin="10 7 10 8">
                        <Grid Margin="0 0 0 5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Margin="0 0 5 0" VerticalAlignment="Center"
                                    Fill="Gray" x:Name="infoStatusDot"/>
                                <Label Padding="0" Content="{DynamicResource Lang.ConnectionInfo.Title}"
                                    FontFamily="{StaticResource SegoeUI}" FontWeight="SemiBold" FontSize="12"
                                    Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Padding="2 0" Click="OnRefreshInfoButtonClick" x:Name="buttonRefreshInfo"
                                ToolTip="{DynamicResource Lang.ConnectionInfo.Refresh}">
                                <TextBlock Text="↻" FontSize="14" FontWeight="Bold"
                                    Foreground="{StaticResource Color.Blue}"/>
                            </Button>
                        </Grid>

                        <Border Padding="7 6" CornerRadius="5"
                            BorderBrush="#404040" BorderThickness="1" Background="#252525">
                            <StackPanel Orientation="Vertical">
                                <Grid Margin="0 0 0 4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontFamily="{StaticResource SegoeUI}" FontSize="9"
                                        Foreground="#8A8A8A" VerticalAlignment="Center"
                                        Text="{DynamicResource Lang.ConnectionInfo.IpLabel}"/>
                                    <TextBlock Grid.Column="1" FontFamily="{StaticResource SegoeUI}"
                                        FontWeight="SemiBold" FontSize="13" Foreground="White"
                                        TextTrimming="CharacterEllipsis" x:Name="textInfoIp"
                                        Text="—"/>
                                </Grid>

                                <Grid Margin="0 0 0 4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontFamily="{StaticResource SegoeUI}" FontSize="9"
                                        Foreground="#8A8A8A" VerticalAlignment="Top" Margin="0 1 0 0"
                                        Text="{DynamicResource Lang.ConnectionInfo.LocationLabel}"/>
                                    <Border Grid.Column="1" Width="26" Height="17" Margin="0 0 6 0"
                                        CornerRadius="2" Background="#1A1A1A" BorderBrush="#505050" BorderThickness="1">
                                        <Grid>
                                            <Image Width="22" Height="14" Stretch="Uniform"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed" x:Name="imageInfoFlag"/>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                FontFamily="Segoe UI Emoji" FontSize="12" x:Name="textInfoFlag"
                                                Text="🌐"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" Orientation="Vertical">
                                        <TextBlock FontFamily="{StaticResource SegoeUI}"
                                            FontWeight="Normal" FontSize="11" Foreground="#E8E8E8"
                                            TextTrimming="CharacterEllipsis" x:Name="textInfoLocation"
                                            Text="—"/>
                                        <TextBlock FontFamily="{StaticResource SegoeUI}"
                                            FontWeight="Light" FontSize="10" Foreground="#B0B0B0"
                                            TextTrimming="CharacterEllipsis" x:Name="textInfoCountry"
                                            Text=""/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0 0 0 5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontFamily="{StaticResource SegoeUI}" FontSize="9"
                                        Foreground="#8A8A8A" VerticalAlignment="Center"
                                        Text="{DynamicResource Lang.ConnectionInfo.ProviderLabel}"/>
                                    <TextBlock Grid.Column="1" FontFamily="{StaticResource SegoeUI}"
                                        FontWeight="Light" FontSize="11" Foreground="#CFCFCF"
                                        TextTrimming="CharacterEllipsis" x:Name="textInfoOrg"
                                        Text="—"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="borderInfoMode" Visibility="Collapsed"
                                        Margin="0 0 8 0" Padding="5 2" CornerRadius="4"
                                        Background="#1E3A5F" BorderBrush="#2F5F9A" BorderThickness="1">
                                        <TextBlock FontFamily="{StaticResource SegoeUI}"
                                            FontWeight="SemiBold" FontSize="10"
                                            Foreground="#7FB2FF" x:Name="textInfoMode"
                                            Text=""/>
                                    </Border>
                                    <TextBlock Grid.Column="1" FontFamily="{StaticResource SegoeUI}"
                                        FontWeight="Normal" FontSize="10" TextWrapping="Wrap"
                                        VerticalAlignment="Center" Foreground="Gray" x:Name="textInfoVerdict"
                                        Text="{DynamicResource Lang.ConnectionInfo.Idle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="0" Background="{StaticResource Color.LightGray}" Margin="0 2 0 0">
                <Grid.Effect>
                    <DropShadowEffect Direction="270" Opacity="0.4" ShadowDepth="2"/>
                </Grid.Effect>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Rectangle Fill="{StaticResource Icon.InvisibleGorilla}" Grid.Column="0" 
                    Width="48" Height="48" Margin="0 2 0 0" 
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    
                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <Label Padding="0" Margin="12 2 0 0" VerticalAlignment="Bottom" 
                        Content="INVISIBLE GORILLA" FontFamily="{StaticResource SegoeUI}" 
                        FontWeight="Light" FontSize="11" Foreground="White"/>
                    <Label Padding="0" Margin="12 -4 0 0" VerticalAlignment="Top" 
                        Content="XRAY" FontFamily="{StaticResource SegoeUI}" 
                        FontWeight="Light" FontSize="30" Foreground="White"/>
                </StackPanel>
            </Grid>
            
            <Grid Grid.Row="2">

                <Grid Height="45" VerticalAlignment="Bottom" 
                    Background="{StaticResource Color.LightGray}">

                    <StackPanel Orientation="Horizontal" Margin="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center">

                        <Button Width="30" Height="30" Margin="0" 
                            Style="{StaticResource Button.Circle}"
                            ToolTip="{DynamicResource Lang.ToolTip.About}" RenderTransformOrigin="0.5,0.5"
                            Click="OnAboutButtonClick">

                            <Rectangle Fill="{StaticResource Icon.About}" Grid.Column="0" 
                                Width="6" Height="14" Margin="0" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Grid Width="30" Height="30" Margin="10 0 0 0">
                            <Button  Style="{StaticResource Button.Circle}" 
                                ToolTip="{DynamicResource Lang.ToolTip.CheckForUpdates}" RenderTransformOrigin="0.5,0.5"
                                Click="OnUpdateButtonClick">

                                <Rectangle Fill="{StaticResource Icon.Update}" Grid.Column="0" 
                                    Width="15" Height="15" Margin="0" 
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Ellipse Width="12" Height="12" Margin="-2" Visibility="Hidden"
                                Fill="{StaticResource Color.Orange}" 
                                Stroke="{StaticResource Color.LightGray}" StrokeThickness="2"
                                VerticalAlignment="Top" HorizontalAlignment="Right"
                                x:Name="notificationUpdate"/>
                        </Grid>
                        <Button Width="30" Height="30" Margin="10 0 0 0" 
                            Style="{StaticResource Button.Circle}"
                            ToolTip="{DynamicResource Lang.ToolTip.Settings}" RenderTransformOrigin="0.5,0.5"
                            Click="OnSettingsButtonClick">

                            <Rectangle Fill="{StaticResource Icon.Settings}" Grid.Column="0" 
                                Width="15" Height="15" Margin="0" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Width="30" Height="30" Margin="10 0 0 0" 
                            Style="{StaticResource Button.Circle}"
                            ToolTip="{DynamicResource Lang.ToolTip.BugReporting}" RenderTransformOrigin="0.5,0.5"
                            Click="OnBugReportingButtonClick">

                            <Rectangle Fill="{StaticResource Icon.Bug}" Grid.Column="0" 
                                Width="12" Height="16" Margin="0" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Width="30" Height="30" Margin="10 0 0 0"
                            Style="{StaticResource Button.Circle}"
                            ToolTip="{DynamicResource Lang.ToolTip.SourceCodeOnGitHub}" RenderTransformOrigin="0.5,0.5"
                            Click="OnGitHubButtonClick">

                            <Rectangle Fill="{StaticResource Icon.Github}" Grid.Column="0" 
                                Width="18" Height="16" Margin="0" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
