<Window x:Class="InvisibleGorillaXRay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvisibleGorillaXRay"
        xmlns:Controls="clr-namespace:InvisibleGorillaXRay.Components"
        mc:Ignorable="d"
        Title="Invisible Gorilla XRay - Settings"
        Height="450" 
        Width="420" 
        WindowStartupLocation="CenterOwner"  
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Background>
        <StaticResource ResourceKey="Color.DarkGray"/>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0 0 0 2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Button Style="{StaticResource Button.Rectangle.Gray}" IsEnabled="False"
                        x:Name="buttonBasicTab" Click="OnBasicTabClick"/>

                    <Label Grid.Row="0" Content="{DynamicResource Lang.Window.Settings.Tab.Basic}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        FontFamily="{StaticResource SegoeUI}" Foreground="White" FontWeight="Normal" 
                        FontSize="13" IsHitTestVisible="False"/>
                </Grid>

                <Grid Grid.Column="2">
                    <Button Style="{StaticResource Button.Rectangle.Gray}"
                        x:Name="buttonPortTab" Click="OnPortTabClick"/>

                    <Label Grid.Row="0" Content="{DynamicResource Lang.Window.Settings.Tab.Port}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        FontFamily="{StaticResource SegoeUI}" Foreground="White" FontWeight="Normal" 
                        FontSize="13" IsHitTestVisible="False"/>
                </Grid>

                <Grid Grid.Column="4">
                    <Button Style="{StaticResource Button.Rectangle.Gray}"
                        x:Name="buttonTunTab" Click="OnTunTabClick"/>

                    <Label Grid.Row="0" Content="{DynamicResource Lang.Window.Settings.Tab.TUN}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        FontFamily="{StaticResource SegoeUI}" Foreground="White" FontWeight="Normal" 
                        FontSize="13" IsHitTestVisible="False"/>
                </Grid>

                <Grid Grid.Column="6">
                    <Button Style="{StaticResource Button.Rectangle.Gray}"
                        x:Name="buttonTorTab" Click="OnTorTabClick"/>

                    <Label Grid.Row="0" Content="{DynamicResource Lang.Window.Settings.Tab.Tor}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        FontFamily="{StaticResource SegoeUI}" Foreground="White" FontWeight="Normal" 
                        FontSize="13" IsHitTestVisible="False"/>
                </Grid>

                <Grid Grid.Column="8">
                    <Button Style="{StaticResource Button.Rectangle.Gray}"
                        x:Name="buttonLogTab" Click="OnLogTabClick"/>

                    <Label Grid.Row="0" Content="{DynamicResource Lang.Window.Settings.Tab.Log}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        FontFamily="{StaticResource SegoeUI}" Foreground="White" FontWeight="Normal" 
                        FontSize="13" IsHitTestVisible="False"/>
                </Grid>
            </Grid>

            <Grid Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="panelBasic" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                
                    <StackPanel Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center" Margin="20 20 20 0" Visibility="Visible">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" Foreground="White" Content="{DynamicResource Lang.Window.Settings.Basic.Language}"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>

                            <ComboBox x:Name="comboBoxLanguage" Grid.Column="1" Height="26"
                                SelectedValuePath="Key" DisplayMemberPath="Value"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14">
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0 5 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" Foreground="White" Content="{DynamicResource Lang.Window.Settings.Basic.Mode}"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>

                            <ComboBox x:Name="comboBoxMode" Grid.Column="1" Height="26"
                                SelectedValuePath="Key" DisplayMemberPath="Value"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"
                                SelectionChanged="OnModeComboBoxSelectionChanged">
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0 5 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" Foreground="White" Content="{DynamicResource Lang.Window.Settings.Basic.Protocol}"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>

                            <ComboBox x:Name="comboBoxProtocol" Grid.Column="1" Height="26"
                                SelectedValuePath="Key" DisplayMemberPath="Value"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14">
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="checkBoxUseSystemProxy" Margin="5 25 0 0" Foreground="White" 
                            Content="{DynamicResource Lang.Window.Settings.Basic.UseSystemProxy}" FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>

                        <CheckBox x:Name="checkBoxEnableUdp" Margin="5 15 0 0" Foreground="White" 
                            Content="{DynamicResource Lang.Window.Settings.Basic.EnbleUdp}" FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>
                            
                        <CheckBox x:Name="checkBoxRunAtStartup" Margin="5 15 0 0" Foreground="White" 
                            Content="{DynamicResource Lang.Window.Settings.Basic.RunAtStartup}" FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>
                        
                        <CheckBox x:Name="checkBoxStartHidden" Margin="5 15 0 0" Foreground="White" 
                            Content="{DynamicResource Lang.Window.Settings.Basic.StartHidden}" FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>

                        <CheckBox x:Name="checkBoxAutoConnect" Margin="5 15 0 0" Foreground="White" 
                            Content="{DynamicResource Lang.Window.Settings.Basic.AutoConnect}" FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>
                        
                        <CheckBox x:Name="checkBoxSendAnalytics" Margin="5 15 0 0" Foreground="White" 
                            FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14">

                            <TextBlock>
                                <Run Text="{DynamicResource Lang.Window.Settings.Basic.SendAnalyticsPart1}" />
                                <Run TextDecorations="Underline"
                                    Foreground="{StaticResource Color.Blue}" 
                                    FontWeight="Normal" FontSize="14" Cursor="Hand"
                                    Text="{DynamicResource Lang.Window.Settings.Basic.SendAnalyticsPart2}"
                                    PreviewMouseDown="OnAnalyticsClick" />
                                <Run Text="{DynamicResource Lang.Window.Settings.Basic.SendAnalyticsPart3}" />
                            </TextBlock>

                        </CheckBox>

                        <Border Margin="0 22 0 0"
                                Padding="12"
                                BorderBrush="{StaticResource Color.LightGray}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <Label Padding="0"
                                       Foreground="White"
                                       Content="{DynamicResource Lang.AppRules.Title}"
                                       FontFamily="{StaticResource SegoeUI}"
                                       FontWeight="SemiBold"
                                       FontSize="15"/>

                                <TextBlock Margin="0 6 0 0"
                                           Foreground="#C9C9C9"
                                           Text="{DynamicResource Lang.AppRules.Description.Desktop}"
                                           TextWrapping="Wrap"
                                           FontFamily="{StaticResource SegoeUI}"
                                           FontSize="12"/>

                                <Border Margin="0 10 0 0"
                                        Padding="10"
                                        BorderBrush="{StaticResource Color.LightGray}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock x:Name="textBlockAppRulesSummary"
                                                   Foreground="White"
                                                   TextWrapping="Wrap"
                                                   FontFamily="{StaticResource SegoeUI}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"/>

                                        <TextBlock x:Name="textBlockAppRulesConfigHint"
                                                   Margin="0 6 0 0"
                                                   Foreground="#C9C9C9"
                                                   TextWrapping="Wrap"
                                                   FontFamily="{StaticResource SegoeUI}"
                                                   FontSize="11"/>

                                        <Button x:Name="buttonManageAppRules"
                                                Width="170"
                                                Height="28"
                                                Margin="0 10 0 0"
                                                HorizontalAlignment="Left"
                                                Content="{DynamicResource Lang.AppRules.Manage}"
                                                Style="{StaticResource Button.Rectangle.Gray}"
                                                FontFamily="{StaticResource SegoeUI}"
                                                FontWeight="Normal"
                                                FontSize="12"
                                                Foreground="White"
                                                Click="OnManageAppRulesClick"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Visibility="Collapsed">
                                    <CheckBox x:Name="checkBoxEnableAppRules"/>
                                    <Button x:Name="buttonRefreshDesktopApps"
                                            Click="OnRefreshAppRulesClick"/>
                                    <StackPanel x:Name="panelAppRulesItems"/>
                                    <TextBlock x:Name="textBlockNoDiscoveredApps"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                            
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="panelPort" Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center" Margin="20 0" Visibility="Hidden">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Foreground="White" Content="{DynamicResource Lang.Window.Settings.Port.Proxy}"
                            FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>

                        <TextBox Grid.Column="1" VerticalContentAlignment="Center" 
                            Style="{StaticResource TextBox.Default}" FontFamily="{StaticResource SegoeUI}" 
                            FontWeight="Normal" FontSize="14"
                            x:Name="textBoxProxyPort"/>
                    </Grid>

                    <Grid Margin="0 5 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Foreground="White" Content="{DynamicResource Lang.Window.Settings.Port.TUN}"
                            FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>

                        <TextBox Grid.Column="1" VerticalContentAlignment="Center" 
                            Style="{StaticResource TextBox.Default}" FontFamily="{StaticResource SegoeUI}" 
                            FontWeight="Normal" FontSize="14"
                            x:Name="textBoxTunPort"/>
                    </Grid>

                    <Grid Margin="0 5 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Foreground="White" Content="{DynamicResource Lang.Window.Settings.Port.Test}"
                            FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>

                        <TextBox Grid.Column="1" VerticalContentAlignment="Center" 
                            Style="{StaticResource TextBox.Default}" FontFamily="{StaticResource SegoeUI}" 
                            FontWeight="Normal" FontSize="14"
                            x:Name="textBoxTestPort"/>
                    </Grid>
                        
                </StackPanel>

                <StackPanel x:Name="panelTun" Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center" Margin="20 0" Visibility="Hidden">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Foreground="White" Content="{DynamicResource Lang.Window.Settings.Tun.DeviceIp}"
                            FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>

                        <TextBox Grid.Column="1" VerticalContentAlignment="Center" 
                            Style="{StaticResource TextBox.Default}" FontFamily="{StaticResource SegoeUI}" 
                            FontWeight="Normal" FontSize="14"
                            x:Name="textBoxTunDeviceIp"/>
                    </Grid>

                    <Grid Margin="0 5 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Foreground="White" Content="{DynamicResource Lang.Window.Settings.Tun.Dns}"
                            FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>

                        <TextBox Grid.Column="1" VerticalContentAlignment="Center" 
                            Style="{StaticResource TextBox.Default}" FontFamily="{StaticResource SegoeUI}" 
                            FontWeight="Normal" FontSize="14"
                            x:Name="textBoxTunDns"/>
                    </Grid>
                        
                </StackPanel>

                <StackPanel x:Name="panelLog" Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center" Margin="20 0" Visibility="Hidden">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Foreground="White" Content="{DynamicResource Lang.Window.Settings.Log.Level}"
                            FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>

                        <ComboBox x:Name="comboBoxLogLevel" Grid.Column="1" Height="26"
                            SelectedValuePath="Key" DisplayMemberPath="Value"
                            FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14">
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0 5 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Foreground="White" Content="{DynamicResource Lang.Window.Settings.Log.Path}"
                            FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>

                        <TextBox Grid.Column="1" VerticalContentAlignment="Center" 
                            Style="{StaticResource TextBox.Default}" FontFamily="{StaticResource SegoeUI}" 
                            FontWeight="Normal" FontSize="14"
                            x:Name="textBoxLogPath"/>
                    </Grid>
                        
                </StackPanel>

                <ScrollViewer x:Name="panelTor" Grid.Row="0" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto" Visibility="Hidden">
                    <StackPanel Orientation="Vertical" Margin="20 15 20 10">
                        <CheckBox x:Name="checkBoxTorEnabled" Foreground="White"
                            Content="{DynamicResource Lang.Tor.Enable}"
                            FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>

                        <Label Margin="0 8 0 0" Foreground="White" Content="{DynamicResource Lang.Tor.QuickConnect}"
                            FontFamily="{StaticResource SegoeUI}" FontWeight="SemiBold" FontSize="14"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="buttonAskTor" Height="28" Margin="0 0 6 6" Padding="10 0"
                                Content="{DynamicResource Lang.Tor.AskTor}"
                                Style="{StaticResource Button.Rectangle.Green}"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Bold" FontSize="12"
                                Foreground="{StaticResource Color.Gray}" Click="OnAskTorClick"/>
                            <Button x:Name="buttonSnowflake" Height="28" Margin="0 0 6 6" Padding="8 0"
                                Content="{DynamicResource Lang.Tor.Method.Snowflake}"
                                Style="{StaticResource Button.Rectangle.Gray}"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="12"
                                Foreground="White" Click="OnSnowflakeClick"/>
                            <Button x:Name="buttonSnowflakeAmp" Height="28" Margin="0 0 6 6" Padding="8 0"
                                Content="{DynamicResource Lang.Tor.Method.SnowflakeAmp}"
                                Style="{StaticResource Button.Rectangle.Gray}"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="12"
                                Foreground="White" Click="OnSnowflakeAmpClick"/>
                            <Button x:Name="buttonMeekAzure" Height="28" Margin="0 0 6 6" Padding="8 0"
                                Content="{DynamicResource Lang.Tor.Method.Meek}"
                                Style="{StaticResource Button.Rectangle.Gray}"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="12"
                                Foreground="White" Click="OnMeekAzureClick"/>
                        </WrapPanel>
                        <Label Foreground="#C9C9C9" Content="{DynamicResource Lang.Tor.GetBridges}"
                            FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="12"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="buttonBridgesEmail" Height="28" Margin="0 0 6 6" Padding="8 0"
                                Content="{DynamicResource Lang.Tor.GetBridges.Email}"
                                Style="{StaticResource Button.Rectangle.Gray}"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="12"
                                Foreground="White" Click="OnBridgesEmailClick"/>
                            <Button x:Name="buttonBridgesTelegram" Height="28" Margin="0 0 6 6" Padding="8 0"
                                Content="{DynamicResource Lang.Tor.GetBridges.Telegram}"
                                Style="{StaticResource Button.Rectangle.Gray}"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="12"
                                Foreground="White" Click="OnBridgesTelegramClick"/>
                        </WrapPanel>

                        <Grid Margin="0 10 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Foreground="White" Content="{DynamicResource Lang.Tor.Mode}"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>
                            <ComboBox x:Name="comboBoxTorMode" Grid.Column="1" Height="26"
                                SelectedValuePath="Key" DisplayMemberPath="Value"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>
                        </Grid>

                        <Grid Margin="0 5 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Foreground="White" Content="{DynamicResource Lang.Tor.BridgeType}"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>
                            <ComboBox x:Name="comboBoxBridgeType" Grid.Column="1" Height="26"
                                SelectedValuePath="Key" DisplayMemberPath="Value"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>
                        </Grid>

                        <Grid Margin="0 5 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Foreground="White" Content="{DynamicResource Lang.Tor.SocksPort}"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>
                            <TextBox Grid.Column="1" VerticalContentAlignment="Center"
                                Style="{StaticResource TextBox.Default}" FontFamily="{StaticResource SegoeUI}"
                                FontWeight="Normal" FontSize="14" x:Name="textBoxTorSocksPort"/>
                        </Grid>

                        <Label Margin="0 6 0 0" Foreground="White" Content="{DynamicResource Lang.Tor.Bridges}"
                            FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="14"/>
                        <TextBox x:Name="textBoxBridges" Height="80"
                            AcceptsReturn="True" TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                            FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="11"/>

                        <WrapPanel Orientation="Horizontal" Margin="0 8 0 0">
                            <Button x:Name="buttonUseDefaultBridges" Height="28" Margin="0 0 6 6" Padding="8 0"
                                Content="{DynamicResource Lang.Tor.UseDefault}"
                                Style="{StaticResource Button.Rectangle.Gray}"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="12"
                                Foreground="White" Click="OnUseDefaultBridgesClick"/>
                            <Button x:Name="buttonFetchMoat" Height="28" Margin="0 0 6 6" Padding="8 0"
                                Content="{DynamicResource Lang.Tor.FetchMoat}"
                                Style="{StaticResource Button.Rectangle.Gray}"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="12"
                                Foreground="White" Click="OnFetchMoatClick"/>
                            <Button x:Name="buttonCheckBridge" Height="28" Margin="0 0 6 6" Padding="8 0"
                                Content="{DynamicResource Lang.Tor.Check}"
                                Style="{StaticResource Button.Rectangle.Gray}"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="12"
                                Foreground="White" Click="OnCheckBridgeClick"/>
                        </WrapPanel>

                        <StackPanel x:Name="panelCaptcha" Visibility="Collapsed" Margin="0 6 0 0">
                            <TextBlock Foreground="#C9C9C9" TextWrapping="Wrap" FontSize="12"
                                FontFamily="{StaticResource SegoeUI}"
                                Text="{DynamicResource Lang.Tor.Captcha.Hint}"/>
                            <Image x:Name="imageCaptcha" Height="80" Margin="0 6 0 0" HorizontalAlignment="Left"/>
                            <TextBox x:Name="textBoxCaptcha" Height="28" Margin="0 6 0 0"
                                Style="{StaticResource TextBox.Default}"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Normal" FontSize="13"/>
                            <Button x:Name="buttonSubmitCaptcha" Height="28" Margin="0 6 0 0" Width="120"
                                HorizontalAlignment="Left"
                                Content="{DynamicResource Lang.Tor.Captcha.Submit}"
                                Style="{StaticResource Button.Rectangle.Green}"
                                FontFamily="{StaticResource SegoeUI}" FontWeight="Bold" FontSize="12"
                                Foreground="{StaticResource Color.Gray}" Click="OnSubmitCaptchaClick"/>
                        </StackPanel>

                        <TextBlock x:Name="textBlockTorStatus" Margin="0 6 0 0" Foreground="#C9C9C9"
                            TextWrapping="Wrap" FontFamily="{StaticResource SegoeUI}" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="15 0">

                    <Button Width="100" Height="30" Content="{DynamicResource Lang.Button.Confirm}" 
                        Style="{StaticResource Button.Rectangle.Green}" 
                        FontFamily="{StaticResource SegoeUI}" FontWeight="Bold" FontSize="12" 
                        Foreground="{StaticResource Color.Gray}"
                        Click="OnConfirmButtonClick">
                    </Button>

                    <Button Width="100" Height="30" Content="{DynamicResource Lang.Button.Cancel}" Margin="10 0 0 0"
                        Style="{StaticResource Button.Rectangle.Red}" 
                        FontFamily="{StaticResource SegoeUI}" FontWeight="Bold" FontSize="12" 
                        Foreground="{StaticResource Color.Gray}"
                        Click="OnCancelButtonClick">
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="0" Background="{StaticResource Color.LightGray}">
            <Grid.Effect>
                <DropShadowEffect Direction="270" Opacity="0.4" ShadowDepth="2"/>
            </Grid.Effect>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Rectangle Fill="{StaticResource Icon.Settings.MintyGreen}" Grid.Column="0" 
                Width="34" Height="35" Margin="0" 
                HorizontalAlignment="Right" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                <Label Padding="0" Margin="15 0 0 0" VerticalAlignment="Bottom" 
                        Content="{DynamicResource Lang.Window.Settings.Title}" FontFamily="{StaticResource SegoeUI}" 
                        FontWeight="Light" FontSize="20" Foreground="White"/>
                <Label Padding="0" Margin="15 0 0 0" VerticalAlignment="Top" 
                        Content="{DynamicResource Lang.Window.Settings.Subtitle}" FontFamily="{StaticResource SegoeUI}" 
                        FontWeight="Light" FontSize="14" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
