<Window x:Class="InvisibleGorillaXRay.GoidaProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Goida Profile"
        Height="680"
        Width="760"
        MinHeight="520"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Window.Background>
        <StaticResource ResourceKey="Color.DarkGray"/>
    </Window.Background>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Foreground="White"
                   FontFamily="{StaticResource SegoeUI}"
                   FontWeight="SemiBold"
                   FontSize="18"
                   Text="{DynamicResource Lang.Goida.Title}"/>
        <TextBlock Grid.Row="0"
                   Margin="0 28 0 0"
                   Foreground="#C9C9C9"
                   TextWrapping="Wrap"
                   FontFamily="{StaticResource SegoeUI}"
                   FontSize="12"
                   Text="{DynamicResource Lang.Goida.Description}"/>

        <Border Grid.Row="1" Margin="0 14 0 0" Padding="12" BorderBrush="{StaticResource Color.LightGray}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <CheckBox x:Name="checkBoxAutoSwitch"
                          Foreground="White"
                          Content="{DynamicResource Lang.Goida.AutoSwitch}"
                          FontFamily="{StaticResource SegoeUI}"
                          Checked="OnSettingsChanged"
                          Unchecked="OnSettingsChanged"/>
                <Grid Margin="0 8 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="comboBoxSelectionMode"
                              Grid.Column="0"
                              Height="28"
                              FontFamily="{StaticResource SegoeUI}"
                              SelectionChanged="OnSettingsChanged"/>
                    <ComboBox x:Name="comboBoxSortMode"
                              Grid.Column="2"
                              Height="28"
                              FontFamily="{StaticResource SegoeUI}"
                              SelectionChanged="OnSortModeChanged"/>
                    <TextBox x:Name="textBoxFilterList"
                             Grid.Column="4"
                             Height="28"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource TextBox.Default}"
                             FontFamily="{StaticResource SegoeUI}"
                             ToolTip="{DynamicResource Lang.Goida.FilterListHint}"
                             TextChanged="OnFilterChanged"/>
                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                        <Button x:Name="buttonRefreshLists" Width="110" Height="28" Margin="0 0 8 0"
                                Content="{DynamicResource Lang.Goida.Refresh}"
                                Style="{StaticResource Button.Rectangle.Gray}"
                                Foreground="White"
                                Click="OnRefreshClick"/>
                        <Button x:Name="buttonProbeAll" Width="110" Height="28"
                                Content="{DynamicResource Lang.Goida.ProbeAll}"
                                Style="{StaticResource Button.Rectangle.Gray}"
                                Foreground="White"
                                Click="OnProbeClick"/>
                    </StackPanel>
                </Grid>
                <TextBlock Margin="0 12 0 0"
                           Foreground="#C9C9C9"
                           FontFamily="{StaticResource SegoeUI}"
                           FontSize="12"
                           Text="{DynamicResource Lang.Goida.ListSelectionTitle}"/>
                <WrapPanel x:Name="panelListPresets" Margin="0 6 0 0" Orientation="Horizontal">
                    <Button Width="90" Height="24" Margin="0 0 6 0"
                            Content="{DynamicResource Lang.Goida.ListPreset.Nodes}"
                            Style="{StaticResource Button.Rectangle.Gray}"
                            Foreground="White"
                            FontSize="11"
                            Click="OnSelectListsNodesClick"/>
                    <Button Width="90" Height="24" Margin="0 0 6 0"
                            Content="{DynamicResource Lang.Goida.ListPreset.Whitelist}"
                            Style="{StaticResource Button.Rectangle.Gray}"
                            Foreground="White"
                            FontSize="11"
                            Click="OnSelectListsWhitelistClick"/>
                    <Button Width="70" Height="24" Margin="0 0 6 0"
                            Content="{DynamicResource Lang.Goida.ListPreset.All}"
                            Style="{StaticResource Button.Rectangle.Gray}"
                            Foreground="White"
                            FontSize="11"
                            Click="OnSelectListsAllClick"/>
                    <Button Width="70" Height="24"
                            Content="{DynamicResource Lang.Goida.ListPreset.None}"
                            Style="{StaticResource Button.Rectangle.Gray}"
                            Foreground="White"
                            FontSize="11"
                            Click="OnSelectListsNoneClick"/>
                </WrapPanel>
                <ScrollViewer Margin="0 6 0 0"
                              MaxHeight="96"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="panelListCheckboxes" Orientation="Horizontal"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0 8 0 0">
            <TextBlock x:Name="textBlockStatus"
                       Foreground="#9AD9B0"
                       TextWrapping="Wrap"
                       FontFamily="{StaticResource SegoeUI}"
                       FontSize="12"/>
            <ProgressBar x:Name="progressProbe"
                         Margin="0 6 0 0"
                         Height="8"
                         Minimum="0"
                         Maximum="16"
                         Visibility="Collapsed"
                         Foreground="{StaticResource Color.Green}"
                         Background="#444444"/>
        </StackPanel>

        <DataGrid x:Name="gridNodes"
                  Grid.Row="3"
                  Margin="0 8 0 0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Extended"
                  SelectionChanged="OnNodeSelectionChanged"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  Background="#2B2B2B"
                  Foreground="White"
                  RowBackground="#2B2B2B"
                  AlternatingRowBackground="#333333"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{StaticResource Color.LightGray}">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#3A3A3A"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="{StaticResource SegoeUI}"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="6 4"/>
                    <Setter Property="BorderBrush" Value="#555555"/>
                    <Setter Property="BorderThickness" Value="0 0 1 1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Lang.Goida.Column.List}" Binding="{Binding ListId}" Width="45"/>
                <DataGridTextColumn Header="{DynamicResource Lang.Goida.Column.Country}" Binding="{Binding Country}" Width="72"/>
                <DataGridTextColumn Header="{DynamicResource Lang.Goida.Column.Protocol}" Binding="{Binding Protocol}" Width="70"/>
                <DataGridTextColumn Header="{DynamicResource Lang.Goida.Column.Name}" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Lang.Goida.Column.Endpoint}" Binding="{Binding Endpoint}" Width="140"/>
                <DataGridTextColumn Header="{DynamicResource Lang.Goida.Column.Latency}" Binding="{Binding LatencyText}" Width="75"/>
                <DataGridTextColumn Header="{DynamicResource Lang.Goida.Column.Status}" Binding="{Binding StatusText}" Width="80"/>
                <DataGridTextColumn Header="{DynamicResource Lang.Goida.Column.LastChecked}" Binding="{Binding LastCheckedText}" Width="90"/>
                <DataGridTextColumn Header="{DynamicResource Lang.Goida.Column.Active}" Binding="{Binding ActiveMark}" Width="50">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#5FD38D"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="{DynamicResource Lang.Goida.Column.Pool}" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding InPool, Mode=OneWay}"
                                      Tag="{Binding Id}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Click="OnPoolCheckBoxClick"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0 12 0 0">
            <TextBlock x:Name="textBlockPoolInfo"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Foreground="#9A9A9A"
                       FontFamily="{StaticResource SegoeUI}"
                       FontSize="12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="120" Height="30" Margin="0 0 10 0"
                        Content="{DynamicResource Lang.Goida.UseBest}"
                        Style="{StaticResource Button.Rectangle.Gray}"
                        Foreground="White"
                        ToolTip="{DynamicResource Lang.Goida.UseBestHint}"
                        Click="OnUseBestClick"/>
                <Button Width="140" Height="30"
                        Content="{DynamicResource Lang.Goida.SetActive}"
                        Style="{StaticResource Button.Rectangle.Green}"
                        Foreground="{StaticResource Color.Gray}"
                        Click="OnSetActiveClick"/>
                <Button Width="140" Height="30" Margin="10 0 0 0"
                        Content="{DynamicResource Lang.Goida.AddToPool}"
                        Style="{StaticResource Button.Rectangle.Gray}"
                        Foreground="White"
                        ToolTip="{DynamicResource Lang.Goida.AddToPoolHint}"
                        Click="OnAddToPoolClick"/>
                <Button Width="110" Height="30" Margin="10 0 0 0"
                        Content="{DynamicResource Lang.Goida.ClearPool}"
                        Style="{StaticResource Button.Rectangle.Gray}"
                        Foreground="White"
                        Click="OnClearPoolClick"/>
                <Button Width="120" Height="30" Margin="10 0 0 0"
                        Content="{DynamicResource Lang.Button.Confirm}"
                        Style="{StaticResource Button.Rectangle.Green}"
                        Foreground="{StaticResource Color.Gray}"
                        Click="OnCloseClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
