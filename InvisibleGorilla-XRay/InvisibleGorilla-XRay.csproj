<Project Sdk="Microsoft.NET.Sdk">



  <PropertyGroup>

    <OutputType>WinExe</OutputType>

    <TargetFramework>net7.0-windows</TargetFramework>

    <RootNamespace>InvisibleGorillaXRay</RootNamespace>

    <AssemblyName>Invisible Gorilla XRay</AssemblyName>

    <Product>Invisible Gorilla XRay</Product>

    <PackageId>Invisible Gorilla XRay</PackageId>

    <Company>Invisible Gorilla</Company>

    <Copyright>Copyright (C) 2025 Invisible Gorilla</Copyright>

    <Version>3.6.51.0</Version>

    <AssemblyVersion>3.6.51.0</AssemblyVersion>

    <Nullable>enable</Nullable>

    <NoWarn>0108;8600;8601;8602;8603;8604;8618;8625;8629;8762</NoWarn>

    <UseWPF>true</UseWPF>

    <ApplicationIcon>Assets/Icon.ico</ApplicationIcon>

    <PublishSingleFile>true</PublishSingleFile>

    <_SuppressWpfTrimError>true</_SuppressWpfTrimError>

    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <PublishTrimmed>true</PublishTrimmed>

    <TrimMode>partial</TrimMode>

  </PropertyGroup>



  <ItemGroup>

    <PackageReference Include="NetCore5.0.Microsoft.Expression.Drawing" Version="1.0.0" />

    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />

    <PackageReference Include="QRCoder.Xaml" Version="1.6.0" />

    <PackageReference Include="System.Drawing.Common" Version="7.0.0" />

    <PackageReference Include="System.Management" Version="7.0.0" />

    <PackageReference Include="System.Windows.Forms" />

  </ItemGroup>



  <ItemGroup>

    <Content Include="Libraries/*.*">

        <CopyToOutputDirectory>Always</CopyToOutputDirectory>

    </Content>



    <Content Include="TUN\**\*.*">

      <CopyToOutputDirectory>Always</CopyToOutputDirectory>

      <CopyToPublishDirectory>Always</CopyToPublishDirectory>

    </Content>



    <Content Include="Tor\**\*.*">

      <CopyToOutputDirectory>Always</CopyToOutputDirectory>

      <CopyToPublishDirectory>Always</CopyToPublishDirectory>

    </Content>

    <Content Include="OpenFlux\openflux.exe" Condition="Exists('OpenFlux\openflux.exe')">

      <CopyToOutputDirectory>Always</CopyToOutputDirectory>

      <CopyToPublishDirectory>Always</CopyToPublishDirectory>

    </Content>

    <Content Include="OpenFlux\NOTICE.txt" Condition="Exists('OpenFlux\NOTICE.txt')">

      <CopyToOutputDirectory>Always</CopyToOutputDirectory>

      <CopyToPublishDirectory>Always</CopyToPublishDirectory>

    </Content>



    <Content Include="*.dat">

      <CopyToOutputDirectory>Always</CopyToOutputDirectory>

    </Content>

  </ItemGroup>

  <Target Name="CopyOpenFluxBinary" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_OpenFluxSrc Condition="Exists('$(MSBuildProjectDirectory)\..\..\whiteBlade\artifacts\openflux\openflux.exe')">$(MSBuildProjectDirectory)\..\..\whiteBlade\artifacts\openflux\openflux.exe</_OpenFluxSrc>
      <_OpenFluxSrc Condition="'$(_OpenFluxSrc)'=='' AND Exists('E:\PPROJECTS\whiteBlade\artifacts\openflux\openflux.exe')">E:\PPROJECTS\whiteBlade\artifacts\openflux\openflux.exe</_OpenFluxSrc>
    </PropertyGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)\OpenFlux" />
    <Copy SourceFiles="$(_OpenFluxSrc)" DestinationFiles="$(MSBuildProjectDirectory)\OpenFlux\openflux.exe" Condition="'$(_OpenFluxSrc)'!=''" SkipUnchangedFiles="true" />
  </Target>

</Project>

